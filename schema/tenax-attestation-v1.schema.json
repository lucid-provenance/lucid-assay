{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenax.io/attestations/assay/v1",
  "title": "Tenax Assay Pipeline Lifecycle Attestation Predicate v1",
  "description": "In-toto predicate carried inside a DSSE-wrapped in-toto Statement (predicateType = this $id). Captures VCS provenance, supply-chain artifact identity, test verification, coverage, assertion-quality heuristics, and the derived Release Confidence Score (RCS) for a single CI pipeline run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicate_version",
    "pipeline",
    "vcs",
    "branch_governance",
    "artifact",
    "test_verification",
    "coverage",
    "assertion_density",
    "release_confidence_score"
  ],
  "properties": {
    "predicate_version": {
      "const": "0.1.0",
      "description": "Schema/predicate semantic version, pinned per attestation for forward-compatible verification."
    },

    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci_provider", "run_id", "run_attempt", "workflow_ref", "started_at", "finished_at"],
      "properties": {
        "ci_provider": { "type": "string", "enum": ["github-actions", "gitlab-ci", "other"] },
        "run_id": { "type": "string", "minLength": 1 },
        "run_attempt": { "type": "integer", "minimum": 1 },
        "workflow_ref": { "type": "string", "minLength": 1, "description": "e.g. org/repo/.github/workflows/ci.yml@refs/heads/main" },
        "runner_environment": { "type": "string", "enum": ["github-hosted", "self-hosted", "gitlab-shared", "gitlab-self-managed", "unknown"], "default": "unknown" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },

    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "branch", "commit_sha"],
      "properties": {
        "provider": { "type": "string", "enum": ["github", "gitlab", "bitbucket", "other"] },
        "repository": { "type": "string", "description": "owner/repo or namespace/project path", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "base_commit_sha": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40}$",
          "description": "Merge-base commit against the target branch, used for patch coverage diffing. Null when unavailable (e.g. push to default branch, shallow clone with no base)."
        },
        "pull_request": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "target_branch": { "type": "string", "minLength": 1 },
            "approvers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Handles of reviewers who approved, deduplicated, as of attestation time."
            },
            "required_approvals": { "type": "integer", "minimum": 0 },
            "review_state": { "type": "string", "enum": ["approved", "changes_requested", "pending", "not_applicable"] }
          },
          "required": ["approvers", "required_approvals", "review_state"]
        }
      }
    },

    "branch_governance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Live GitHub branch-governance check (cli/parsers/github_rules.py): whether the target branch would actually let this change land unreviewed, independent of this PR's own approval state. A top-level predicate field, always present (not nested under vcs).",
      "required": [
        "available", "branch", "pull_request_required", "approvals_required",
        "direct_push_prevented", "bypass_actors_count", "admin_enforced", "warnings", "reason"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "branch": { "type": "string" },
        "pull_request_required": { "type": "boolean" },
        "approvals_required": { "type": "integer", "minimum": 0 },
        "direct_push_prevented": { "type": "boolean" },
        "bypass_actors_count": { "type": "integer", "minimum": 0 },
        "admin_enforced": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "reason_code": {
          "type": ["string", "null"],
          "description": "Machine-readable classification of a specific known available=false cause (e.g. platform_unsupported_tier). Null/absent for every other case -- must not be inferred as a generic failure."
        }
      }
    },

    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject"],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "digest"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "OCI image ref or artifact name, e.g. registry/org/svc" },
            "digest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256"],
              "properties": {
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        },
        "sbom": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "format": { "type": "string", "enum": ["spdx-json", "cyclonedx-json", "syft-json"] },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "uri": { "type": "string", "format": "uri", "description": "Content-addressed WORM storage URI, e.g. s3://evidence/sha256/<hash>" }
          },
          "required": ["format", "sha256", "uri"]
        }
      }
    },

    "test_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "report_format", "report_sha256", "totals", "duration_ms"],
      "properties": {
        "framework": { "type": "string", "examples": ["jest", "pytest", "junit5", "go-test"] },
        "report_format": { "type": "string", "enum": ["junit-xml", "jest-json", "tap"] },
        "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "report_uri": { "type": "string", "format": "uri" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tests", "passed", "failed", "errored", "skipped"],
          "properties": {
            "tests": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "errored": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          }
        },
        "flaky_retries": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Count of test cases that failed at least once then passed on retry within this run."
        },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "report_sha256", "overall", "patch", "thresholds"],
      "properties": {
        "format": { "type": "string", "enum": ["cobertura-xml", "lcov", "jacoco-xml"] },
        "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "report_uri": { "type": "string", "format": "uri" },
        "overall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line_rate", "branch_rate"],
          "properties": {
            "line_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "branch_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "line_rate", "lines_changed", "lines_covered", "reason"],
          "properties": {
            "available": { "type": "boolean", "description": "False when base_commit_sha is unavailable or diff yields zero coverable changed lines." },
            "line_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "lines_changed": { "type": "integer", "minimum": 0 },
            "lines_covered": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" },
            "reason_code": {
              "type": ["string", "null"],
              "description": "Machine-readable classification of a specific known available=false cause (e.g. no_coverable_lines). Null/absent for every other case."
            }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overall_min", "patch_min", "overall_met", "patch_met"],
          "properties": {
            "overall_min": { "type": "number", "minimum": 0, "maximum": 1 },
            "patch_min": { "type": "number", "minimum": 0, "maximum": 1 },
            "overall_met": { "type": "boolean" },
            "patch_met": { "type": "boolean" }
          }
        }
      }
    },

    "assertion_density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_assertions", "total_test_functions", "density_ratio", "heuristics"],
      "properties": {
        "total_assertions": { "type": "integer", "minimum": 0 },
        "total_test_functions": { "type": "integer", "minimum": 0 },
        "density_ratio": { "type": ["number", "null"], "minimum": 0, "description": "assertions / test_functions; null when total_test_functions is 0." },
        "heuristics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "empty_test_bodies": { "type": "integer", "minimum": 0, "description": "Test functions with zero assertions and zero meaningful statements." },
            "assertion_only_true": { "type": "integer", "minimum": 0, "description": "Suspicious tautological assertions, e.g. assert True / expect(true).toBe(true)." },
            "skipped_or_disabled_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "ast_skipped_test_functions": { "type": "integer", "minimum": 0, "description": "Test functions the AST engine identified as skipped/disabled (e.g. @Disabled, it.skip, t.Skip-wholesale, @unittest.skip*) across every scanned language; excluded from total_test_functions/total_assertions." }
          }
        },
        "languages": {
          "type": "object",
          "description": "Per-language breakdown of the AST assertion engine's scan, keyed by language id (python, typescript, javascript, go, java). Absent/empty on older attestations predating multi-language support.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files_scanned": { "type": "integer", "minimum": 0 },
              "total_test_functions": { "type": "integer", "minimum": 0 },
              "total_assertions": { "type": "integer", "minimum": 0 },
              "tautological_assertions": { "type": "integer", "minimum": 0 },
              "empty_test_bodies": { "type": "integer", "minimum": 0 },
              "skipped_test_functions": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },

    "static_analysis": {
      "type": "object",
      "additionalProperties": false,
      "description": "SARIF 2.1.0 static-analysis findings (see cli/parsers/sarif.py), differential-scored against the patch. available=true with empty tools/findings when no --sarif input was configured for this run at all (a control that was never invoked isn't penalized) -- distinct from available=false, which means a --sarif input was configured but couldn't be read/parsed. Absent entirely on attestations predating this feature.",
      "required": [
        "available", "format", "total_findings", "errors_count", "warnings_count",
        "notes_count", "patch_errors_count", "patch_warnings_count", "findings"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "format": { "type": "string", "enum": ["sarif-2.1.0"] },
        "total_findings": { "type": "integer", "minimum": 0 },
        "errors_count": { "type": "integer", "minimum": 0 },
        "warnings_count": { "type": "integer", "minimum": 0 },
        "notes_count": { "type": "integer", "minimum": 0 },
        "none_count": { "type": "integer", "minimum": 0 },
        "patch_errors_count": {
          "type": "integer", "minimum": 0,
          "description": "Findings at level=error whose file/line intersects the diff's changed lines -- weighed far more heavily by the scorer than a pre-existing baseline finding."
        },
        "patch_warnings_count": { "type": "integer", "minimum": 0 },
        "tools_scanned": { "type": "array", "items": { "type": "string" } },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human-readable causes when available=false (e.g. an unreadable/corrupt --sarif input); aggregation fails closed, so any one bad input taints the whole report."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_name", "rule_id", "level", "message", "file_path", "start_line", "is_new_in_patch"],
            "properties": {
              "tool_name": { "type": "string" },
              "rule_id": { "type": "string" },
              "level": { "type": "string", "enum": ["error", "warning", "note", "none"] },
              "message": { "type": "string" },
              "file_path": { "type": "string" },
              "start_line": { "type": "integer", "minimum": 0 },
              "is_new_in_patch": { "type": "boolean" },
              "category": { "type": ["string", "null"] },
              "tags": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "tools": {
          "type": "array",
          "description": "Per-tool breakdown: driver metadata, rule-ID/category/tag grouping, a raw-report integrity hash, and an extensible bag for tool-specific enrichments (e.g. SonarQube quality gate). Concatenated across multiple --sarif inputs, one entry per (file, tool) pair -- each keeps its own file's report_hash rather than being merged across files.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "summary", "report_hash"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": ["string", "null"] },
              "information_uri": { "type": ["string", "null"] },
              "summary": {
                "type": "object",
                "additionalProperties": false,
                "required": ["errors", "warnings", "notes", "none", "total_findings"],
                "properties": {
                  "errors": { "type": "integer", "minimum": 0 },
                  "warnings": { "type": "integer", "minimum": 0 },
                  "notes": { "type": "integer", "minimum": 0 },
                  "none": { "type": "integer", "minimum": 0 },
                  "total_findings": { "type": "integer", "minimum": 0 }
                }
              },
              "rules": {
                "type": "array",
                "description": "Findings for this tool, grouped by rule ID.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["rule_id", "count"],
                  "properties": {
                    "rule_id": { "type": "string" },
                    "count": { "type": "integer", "minimum": 0 },
                    "category": { "type": ["string", "null"] },
                    "tags": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "extensions": {
                "type": "object",
                "description": "Tool-specific metadata not part of the core SARIF result shape, e.g. SonarQube's quality gate or complexity/debt metrics -- sourced from a SARIF run's own properties bag, or merged in externally via --sonar-metrics for a scanner that doesn't embed them.",
                "properties": {
                  "sonarqube": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "quality_gate": { "type": "string", "enum": ["PASSED", "FAILED", "WARN", "NONE"] },
                      "cognitive_complexity": { "type": "integer" },
                      "technical_debt_minutes": { "type": "integer" }
                    }
                  }
                }
              },
              "report_hash": {
                "type": "object",
                "additionalProperties": false,
                "required": ["algorithm", "value"],
                "description": "SHA-256 of the raw SARIF file this tool's results were parsed from.",
                "properties": {
                  "algorithm": { "type": "string" },
                  "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        }
      }
    },

    "release_confidence_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "algorithm_version", "components", "computed_at"],
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "algorithm_version": { "type": "string", "const": "rcs-v0.1" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test_health", "patch_coverage", "overall_coverage", "assertion_integrity", "governance"],
          "properties": {
            "test_health": { "$ref": "#/$defs/scoreComponent" },
            "patch_coverage": { "$ref": "#/$defs/scoreComponent" },
            "overall_coverage": { "$ref": "#/$defs/scoreComponent" },
            "assertion_integrity": { "$ref": "#/$defs/scoreComponent" },
            "governance": { "$ref": "#/$defs/scoreComponent" },
            "static_analysis": {
              "$ref": "#/$defs/scoreComponent",
              "description": "Not in `required`: absent on attestations predating the SARIF static-analysis component (cli/scorer.py WEIGHTS)."
            }
          }
        },
        "degraded": {
          "type": "boolean",
          "default": false,
          "description": "True if any component fell back to a penalized default due to missing/unavailable input data."
        },
        "degraded_reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Which independent trigger(s) caused degraded=true (e.g. no_pr_context, sarif_unavailable, a namespaced branch_governance:<reason_code> / patch_coverage:<reason_code>). Empty when degraded=false. Absent/malformed on an attestation predating this field -- cli/verify.py's --disallow-degraded treats that as non-exempt."
        },
        "computed_at": { "type": "string", "format": "date-time" }
      }
    }
  },

  "$defs": {
    "scoreComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "raw_score", "weighted_score", "reason"],
      "properties": {
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "weighted_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string", "description": "Human/auditor-readable justification, e.g. 'zero tests executed', 'patch coverage unavailable, fell back to overall*0.7'." }
      }
    }
  }
}
